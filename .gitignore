```gitignore
# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class

# C Extensions
*.so

# Distribution / Packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# =========================
# Virtual Environments
# =========================
.venv/
venv/
env/
ENV/

# =========================
# Environment Variables
# =========================
.env
.env.*
!.env.example

# =========================
# IDEs
# =========================
.vscode/
.idea/
*.swp
*.swo

# =========================
# Jupyter
# =========================
.ipynb_checkpoints/

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# Testing
# =========================
.pytest_cache/
.coverage
htmlcov/
.cache/
.tox/
.nox/

# =========================
# MyPy
# =========================
.mypy_cache/

# =========================
# Ruff
# =========================
.ruff_cache/

# # =========================
# # ChromaDB
# # =========================
# chroma_db/

# # =========================
# # Uploaded Documents
# # =========================
# data/

# Keep directory structure
!data/.gitkeep

# =========================
# OS Files
# =========================
.DS_Store
Thumbs.db

# =========================
# FastAPI
# =========================
*.pid

# =========================
# Temporary Files
# =========================
tmp/
temp/

# =========================
# Docker
# =========================
docker-compose.override.yml

# =========================
# Terraform (Future Use)
# =========================
terraform.tfstate
terraform.tfstate.*
.terraform/
.terraform.lock.hcl

# =========================
# Kubernetes Secrets
# =========================
*.secret.yaml

# =========================
# Misc
# =========================
coverage.xml
```
